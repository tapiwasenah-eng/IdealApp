rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net
    match /{document=**} { 
      allow read, write: if isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Support collection group queries for admins
    match /{path=**}/documents/{docId} {
      allow read: if isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'plan', 'role', 'createdAt'])
        && data.email is string && data.email.size() <= 256
        && data.plan is string && (data.plan == 'free' || data.plan == 'pro' || data.plan == 'studio')
        && data.role is string && (data.role == 'user' || data.role == 'admin')
        && data.createdAt != null;
    }
    
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) 
                    && isValidId(userId)
                    && isValidUser(incoming());
      allow update: if isOwner(userId) 
                    && isValidUser(incoming())
                    && incoming().diff(existing()).affectedKeys().hasAny(['email', 'displayName', 'photoURL', 'plan', 'role', 'aiRequestsToday', 'lastAiRequestDate']);
      
      
      match /documents/{documentId} {
        allow read, write: if isOwner(userId);
        
        match /sections/{sectionId} {
          allow read, write: if isOwner(userId);
        }
      }

      match /templates/{templateId} {
        allow read, write: if isOwner(userId);
      }
      
      match /investors/{investorId} {
        function isValidInvestor(data) {
          return data.keys().hasAll(['name', 'isLocked'])
            && data.name is string && data.name.size() <= 256
            && data.isLocked is bool;
        }
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(investorId) && isValidInvestor(incoming());
        allow update: if isOwner(userId) && isValidInvestor(incoming());
        allow delete: if isOwner(userId);
      }
      
      match /outreach/{outreachId} {
        function isValidOutreach(data) {
          return data.keys().hasAll(['investorId', 'status'])
            && data.investorId is string && data.investorId.size() <= 128
            && data.status is string && data.status.size() <= 50;
        }
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(outreachId) && isValidOutreach(incoming());
        allow update: if isOwner(userId) && isValidOutreach(incoming());
        allow delete: if isOwner(userId);
      }
      
      // Allow user to write to any other personal subcollection
      match /{subcollection}/{docId} {
        allow read, write: if isOwner(userId);
        match /{document=**} { allow read, write: if isOwner(userId); }
      }
    }
    
    match /investors/{investorId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    
    match /templates/{templateId} {
      allow read: if true;
      allow write: if true; // We will allow auth users to write community templates for now
    }
    
    match /workspaces/{id} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.owner_uid == request.auth.uid || incoming().owner_uid == request.auth.uid);
      match /{document=**} { allow read, write: if isSignedIn(); }
    }
    match /user_investor_preferences/{id} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.ownerId == request.auth.uid || incoming().ownerId == request.auth.uid);
    }
    match /company_dna/{id} {
      allow read, write: if isSignedIn(); // Let users read/write DNA
    }
    match /outreach/{id} {
      allow read, write: if isSignedIn();
    }
    match /conversations/{id} {
      allow read, write: if isSignedIn();
    }
    match /datarooms/{id} {
      allow read, write: if isSignedIn();
      match /{document=**} { allow read, write: if isSignedIn(); }
    }
    match /invites/{id} {
      allow read, write: if isSignedIn();
    }
    match /dashboard_metrics/{id} {
      allow read, write: if isSignedIn();
    }
    match /investor_insights/{id} {
      allow read, write: if isSignedIn();
    }
    
    function isValidDataRoomLink(data) {
      return data.keys().hasAll(['token', 'ownerId', 'hasPassword', 'allowDownload', 'viewCount'])
        && data.token is string && data.token.size() <= 128
        && data.ownerId is string && data.ownerId.size() <= 128
        && data.hasPassword is bool
        && data.allowDownload is bool
        && data.viewCount is number;
    }
    
    match /dataRoomLinks/{linkId} {
      allow read: if true;
      allow create: if isSignedIn()
                    && request.auth.uid == incoming().ownerId
                    && isValidId(linkId)
                    && isValidDataRoomLink(incoming())
                    && (!('documentIds' in incoming()) || (incoming().documentIds is list && incoming().documentIds.size() <= 100));
      allow update: if (isSignedIn() && existing().ownerId == request.auth.uid && isValidDataRoomLink(incoming()))
                    || (incoming().diff(existing()).affectedKeys().hasOnly(['viewCount', 'accessLog']) && isValidDataRoomLink(incoming()));
      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;
    }
    
    function isValidDataRoomView(data) {
      return data.keys().hasAll(['linkId', 'token', 'ownerId', 'documentId', 'timestamp'])
        && data.linkId is string && data.linkId.size() <= 128
        && data.token is string && data.token.size() <= 128
        && data.ownerId is string && data.ownerId.size() <= 128
        && data.documentId is string && data.documentId.size() <= 128
        && data.timestamp != null;
    }
    
    match /dataRoomViews/{viewId} {
      allow read: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isValidDataRoomView(incoming()) && isValidId(viewId);
      allow update: if false; 
      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;
    }
  }
}
