# Frontend (VITE_ prefixed)
VITE_ANTHROPIC_API_KEY=
VITE_PAYPAL_CLIENT_ID=YOUR_SANDBOX_CLIENT_ID
VITE_PAYPAL_PRO_PLAN_ID=P-YOUR_PLAN_ID_HERE

# Backend Only (NEVER prefix with VITE_)
# AI Providers
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
FRONTEND_URL=
GEMINI_MODELS=gemini-2.0-flash,gemini-1.5-flash

# Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# PayPal Configuration
PAYPAL_ENV=sandbox
PAYPAL_SANDBOX_CLIENT_ID=YOUR_SANDBOX_CLIENT_ID
PAYPAL_SANDBOX_SECRET=YOUR_SANDBOX_SECRET
PAYPAL_SANDBOX_WEBHOOK_ID=YOUR_SANDBOX_WEBHOOK_ID

# Cross-Origin
CORS_ORIGINS=https://your-production-app.run.app,http://localhost:5173,http://localhost:3000
