{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Document": {
      "title": "Document",
      "description": "A workspace document with canvas data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "canvasData": { "type": "string" },
        "status": { "type": "string", "enum": ["In Progress", "Completed", "Review"] },
        "lastModified": { "type": "string", "format": "date-time" },
        "type": { "type": "string" }
      },
      "required": ["userId", "title", "canvasData", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "/documents/{docId}": {
      "schema": "Document",
      "description": "Workspace documents"
    }
  }
}
