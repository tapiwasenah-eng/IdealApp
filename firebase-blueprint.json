{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "plan": { "type": "string", "enum": ["free", "pro", "enterprise"] },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "aiRequestsToday": { "type": "number" },
        "lastAiRequestDate": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "plan", "createdAt"]
    },
    "Template": {
      "title": "Template",
      "description": "System or user template",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "document_type": { "type": "string" },
        "category": { "type": "string" },
        "sector_tags": { "type": "array" },
        "stage_tags": { "type": "array" },
        "sections": { "type": "array" },
        "is_premium": { "type": "boolean" },
        "is_community": { "type": "boolean" },
        "created_by": { "type": "string" }
      },
      "required": ["name", "document_type", "category"]
    },
    "UserDocument": {
      "title": "UserDocument",
      "description": "A founder's document",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "document_type": { "type": "string" },
        "template_id": { "type": "string" },
        "source": { "type": "string", "enum": ["upload", "template", "blank"] },
        "sections": { "type": "array" },
        "status": { "type": "string", "enum": ["draft", "active", "in_review", "complete"] },
        "stage": { "type": "string" },
        "sector": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "document_type", "source", "status", "created_at"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "/templates/{templateId}": {
      "schema": "Template",
      "description": "Global system templates"
    },
    "/users/{userId}/documents/{docId}": {
      "schema": "UserDocument",
      "description": "User's documents"
    },
    "/users/{userId}/templates/{templateId}": {
      "schema": "Template",
      "description": "User's custom templates"
    }
  }
}
